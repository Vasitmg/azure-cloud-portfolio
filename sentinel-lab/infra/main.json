{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.49.2.45890",
      "templateHash": "10674757639669123663"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "germanywestcentral",
      "metadata": {
        "description": "Azure region for all resources"
      }
    },
    "projectName": {
      "type": "string",
      "defaultValue": "sentinel-lab",
      "metadata": {
        "description": "Short name used in all resource names"
      }
    },
    "retentionInDays": {
      "type": "int",
      "defaultValue": 90,
      "minValue": 30,
      "maxValue": 90,
      "metadata": {
        "description": "Days to keep logs (Sentinel includes 90 days at no extra retention cost)"
      }
    },
    "dailyQuotaGb": {
      "type": "int",
      "defaultValue": 1,
      "metadata": {
        "description": "Daily ingestion cap in GB to protect your budget (-1 = no cap)"
      }
    }
  },
  "variables": {
    "tags": {
      "project": "[parameters('projectName')]",
      "environment": "lab",
      "managedBy": "bicep"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2024-03-01",
      "name": "[format('rg-{0}', parameters('projectName'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Insights/diagnosticSettings",
      "apiVersion": "2021-05-01-preview",
      "name": "activity-to-sentinel",
      "properties": {
        "copy": [
          {
            "name": "logs",
            "count": "[length(createArray('Administrative', 'Security', 'ServiceHealth', 'Alert', 'Recommendation', 'Policy', 'Autoscale', 'ResourceHealth'))]",
            "input": {
              "category": "[createArray('Administrative', 'Security', 'ServiceHealth', 'Alert', 'Recommendation', 'Policy', 'Autoscale', 'ResourceHealth')[copyIndex('logs')]]",
              "enabled": true
            }
          }
        ],
        "workspaceId": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, format('rg-{0}', parameters('projectName'))), 'Microsoft.Resources/deployments', 'sentinel-deployment'), '2025-04-01').outputs.workspaceId.value]"
      },
      "dependsOn": [
        "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, format('rg-{0}', parameters('projectName'))), 'Microsoft.Resources/deployments', 'sentinel-deployment')]"
      ]
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "sentinel-deployment",
      "resourceGroup": "[format('rg-{0}', parameters('projectName'))]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "workspaceName": {
            "value": "[format('log-{0}', parameters('projectName'))]"
          },
          "retentionInDays": {
            "value": "[parameters('retentionInDays')]"
          },
          "dailyQuotaGb": {
            "value": "[parameters('dailyQuotaGb')]"
          },
          "tags": {
            "value": "[variables('tags')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.49.2.45890",
              "templateHash": "1768021961259380968"
            }
          },
          "parameters": {
            "location": {
              "type": "string"
            },
            "workspaceName": {
              "type": "string"
            },
            "retentionInDays": {
              "type": "int"
            },
            "dailyQuotaGb": {
              "type": "int"
            },
            "tags": {
              "type": "object"
            }
          },
          "resources": [
            {
              "type": "Microsoft.OperationalInsights/workspaces",
              "apiVersion": "2023-09-01",
              "name": "[parameters('workspaceName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "sku": {
                  "name": "PerGB2018"
                },
                "retentionInDays": "[parameters('retentionInDays')]",
                "workspaceCapping": {
                  "dailyQuotaGb": "[parameters('dailyQuotaGb')]"
                }
              }
            },
            {
              "type": "Microsoft.SecurityInsights/onboardingStates",
              "apiVersion": "2024-03-01",
              "scope": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
              "name": "default",
              "properties": {},
              "dependsOn": [
                "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]"
              ]
            }
          ],
          "outputs": {
            "workspaceName": {
              "type": "string",
              "value": "[parameters('workspaceName')]"
            },
            "workspaceId": {
              "type": "string",
              "value": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]"
            }
          }
        }
      },
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', format('rg-{0}', parameters('projectName')))]"
      ]
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "analytics-rules-deployment",
      "resourceGroup": "[format('rg-{0}', parameters('projectName'))]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "workspaceName": {
            "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, format('rg-{0}', parameters('projectName'))), 'Microsoft.Resources/deployments', 'sentinel-deployment'), '2025-04-01').outputs.workspaceName.value]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.49.2.45890",
              "templateHash": "14799590897075041459"
            }
          },
          "parameters": {
            "workspaceName": {
              "type": "string"
            }
          },
          "variables": {
            "$fxv#0": "// =====================================================================\n// Detection: New Azure RBAC role assignment\n// ---------------------------------------------------------------------\n// Data source : AzureActivity (subscription Activity Log)\n// MITRE ATT&CK: TA0003 Persistence / TA0004 Privilege Escalation\n//               T1098 Account Manipulation\n// Rule type   : Scheduled query rule\n// Frequency   : every 1 hour, look back 1 hour\n// Severity    : High for Owner / User Access Administrator / Contributor,\n//               Medium for every other role\n//\n// Why it matters:\n// An attacker who gets into a tenant often grants an account (their own\n// or a new service principal) a powerful role so they keep access even\n// if the original foothold is removed.\n//\n// How it works:\n// Azure logs each role assignment as several events with the same\n// CorrelationId. Only the \"Start\" event contains the request body with\n// the role and the principal; the \"Success\" event confirms it worked.\n// The query joins both events on CorrelationId.\n//\n// How to test:\n// Portal > Resource groups > rg-sentinel-lab > Access control (IAM)\n// > Add role assignment > Reader > assign to yourself.\n// Wait 15-20 minutes, then run this query in Sentinel > Logs.\n// Remove the assignment again afterwards.\n// =====================================================================\nlet lookback = 1h;\nlet privilegedRoles = dynamic([\n    \"8e3af657-a8ff-443c-a75c-2fe8c4bcb635\",  // Owner\n    \"18d7d88d-d35e-4fb5-a5c3-7773c20a72d9\",  // User Access Administrator\n    \"b24988ac-6180-42a0-ab88-20f7382dd24c\"   // Contributor\n]);\nlet roleAssignmentEvents = AzureActivity\n    | where TimeGenerated > ago(lookback)\n    | where OperationNameValue =~ \"MICROSOFT.AUTHORIZATION/ROLEASSIGNMENTS/WRITE\";\nlet requests = roleAssignmentEvents\n    | where ActivityStatusValue =~ \"Start\"\n    | extend Body = todynamic(tostring(Properties_d.requestbody))\n    // keys can be upper- or lower-case, so check both\n    | extend RoleDefinitionId = tostring(coalesce(Body.Properties.RoleDefinitionId, Body.properties.roleDefinitionId))\n    | extend PrincipalId      = tostring(coalesce(Body.Properties.PrincipalId, Body.properties.principalId))\n    | extend PrincipalType    = tostring(coalesce(Body.Properties.PrincipalType, Body.properties.principalType))\n    | extend AssignmentScope  = tostring(coalesce(Body.Properties.Scope, Body.properties.scope))\n    | project CorrelationId, RoleDefinitionId, PrincipalId, PrincipalType, AssignmentScope;\nroleAssignmentEvents\n| where ActivityStatusValue =~ \"Success\"\n| join kind=leftouter requests on CorrelationId\n| extend RoleGuid = tostring(split(RoleDefinitionId, \"/\")[-1])\n| extend Severity = iff(RoleGuid in (privilegedRoles), \"High\", \"Medium\")\n| project TimeGenerated, Caller, CallerIpAddress, Severity, RoleGuid,\n          PrincipalId, PrincipalType, AssignmentScope, ResourceGroup, CorrelationId\n| order by TimeGenerated desc",
            "$fxv#1": "// =====================================================================\n// Detection: Security logging or detection tampering\n// ---------------------------------------------------------------------\n// Data source : AzureActivity (subscription Activity Log)\n// MITRE ATT&CK: TA0005 Defense Evasion\n//               T1562 Impair Defenses\n//               (T1562.008 Disable or Modify Cloud Logs)\n// Rule type   : Scheduled query rule\n// Frequency   : every 1 hour, look back 1 hour\n// Severity    : High\n//\n// Why it matters:\n// Before doing damage, attackers often try to blind the defenders:\n// they delete diagnostic settings (log forwarding), the Log Analytics\n// workspace, Sentinel analytics rules or data connectors. Any of these\n// actions should be rare and always reviewed.\n//\n// How to test (safe):\n// Sentinel > Analytics > select \"New Azure RBAC role assignment\" > Delete.\n// Wait 15-20 minutes, run this query, then restore the rule by running\n// the Bicep deployment again.\n// =====================================================================\nlet lookback = 1h;\nlet tamperingOperations = dynamic([\n    \"MICROSOFT.INSIGHTS/DIAGNOSTICSETTINGS/DELETE\",\n    \"MICROSOFT.OPERATIONALINSIGHTS/WORKSPACES/DELETE\",\n    \"MICROSOFT.SECURITYINSIGHTS/ALERTRULES/DELETE\",\n    \"MICROSOFT.SECURITYINSIGHTS/DATACONNECTORS/DELETE\",\n    \"MICROSOFT.SECURITYINSIGHTS/AUTOMATIONRULES/DELETE\"\n]);\nAzureActivity\n| where TimeGenerated > ago(lookback)\n| where OperationNameValue in~ (tamperingOperations)\n| where ActivityStatusValue =~ \"Success\"\n| extend Action = tostring(split(OperationNameValue, \"/\")[-2])\n| project TimeGenerated, Caller, CallerIpAddress, OperationNameValue, Action,\n          TargetResource = _ResourceId, ResourceGroup, CorrelationId\n| order by TimeGenerated desc"
          },
          "resources": [
            {
              "type": "Microsoft.SecurityInsights/alertRules",
              "apiVersion": "2024-03-01",
              "scope": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
              "name": "[guid(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName')), 'role-assignment-created')]",
              "kind": "Scheduled",
              "properties": {
                "displayName": "New Azure RBAC role assignment",
                "description": "Detects a successful Azure role assignment. Owner, Contributor and User Access Administrator are rated High, all other roles Medium. Attackers grant roles to keep access (MITRE T1098).",
                "enabled": true,
                "query": "[variables('$fxv#0')]",
                "queryFrequency": "PT1H",
                "queryPeriod": "PT1H",
                "triggerOperator": "GreaterThan",
                "triggerThreshold": 0,
                "severity": "Medium",
                "suppressionEnabled": false,
                "suppressionDuration": "PT1H",
                "tactics": [
                  "Persistence",
                  "PrivilegeEscalation"
                ],
                "techniques": [
                  "T1098"
                ],
                "eventGroupingSettings": {
                  "aggregationKind": "AlertPerResult"
                },
                "alertDetailsOverride": {
                  "alertDisplayNameFormat": "Role assignment by {{Caller}} (role {{RoleGuid}})",
                  "alertSeverityColumnName": "Severity"
                },
                "entityMappings": [
                  {
                    "entityType": "Account",
                    "fieldMappings": [
                      {
                        "identifier": "FullName",
                        "columnName": "Caller"
                      }
                    ]
                  },
                  {
                    "entityType": "IP",
                    "fieldMappings": [
                      {
                        "identifier": "Address",
                        "columnName": "CallerIpAddress"
                      }
                    ]
                  }
                ],
                "incidentConfiguration": {
                  "createIncident": true,
                  "groupingConfiguration": {
                    "enabled": false,
                    "reopenClosedIncident": false,
                    "lookbackDuration": "PT5H",
                    "matchingMethod": "AllEntities"
                  }
                }
              }
            },
            {
              "type": "Microsoft.SecurityInsights/alertRules",
              "apiVersion": "2024-03-01",
              "scope": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
              "name": "[guid(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName')), 'security-logging-tampering')]",
              "kind": "Scheduled",
              "properties": {
                "displayName": "Security logging or detection tampering",
                "description": "Detects deletion of diagnostic settings, the Log Analytics workspace, Sentinel analytics rules, data connectors or automation rules. Attackers do this to blind defenders (MITRE T1562).",
                "enabled": true,
                "query": "[variables('$fxv#1')]",
                "queryFrequency": "PT1H",
                "queryPeriod": "PT1H",
                "triggerOperator": "GreaterThan",
                "triggerThreshold": 0,
                "severity": "High",
                "suppressionEnabled": false,
                "suppressionDuration": "PT1H",
                "tactics": [
                  "DefenseEvasion"
                ],
                "techniques": [
                  "T1562"
                ],
                "eventGroupingSettings": {
                  "aggregationKind": "AlertPerResult"
                },
                "alertDetailsOverride": {
                  "alertDisplayNameFormat": "{{Action}} deleted by {{Caller}}"
                },
                "entityMappings": [
                  {
                    "entityType": "Account",
                    "fieldMappings": [
                      {
                        "identifier": "FullName",
                        "columnName": "Caller"
                      }
                    ]
                  },
                  {
                    "entityType": "IP",
                    "fieldMappings": [
                      {
                        "identifier": "Address",
                        "columnName": "CallerIpAddress"
                      }
                    ]
                  },
                  {
                    "entityType": "AzureResource",
                    "fieldMappings": [
                      {
                        "identifier": "ResourceId",
                        "columnName": "TargetResource"
                      }
                    ]
                  }
                ],
                "incidentConfiguration": {
                  "createIncident": true,
                  "groupingConfiguration": {
                    "enabled": false,
                    "reopenClosedIncident": false,
                    "lookbackDuration": "PT5H",
                    "matchingMethod": "AllEntities"
                  }
                }
              }
            }
          ]
        }
      },
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', format('rg-{0}', parameters('projectName')))]",
        "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, format('rg-{0}', parameters('projectName'))), 'Microsoft.Resources/deployments', 'sentinel-deployment')]"
      ]
    }
  ],
  "outputs": {
    "resourceGroupName": {
      "type": "string",
      "value": "[format('rg-{0}', parameters('projectName'))]"
    },
    "workspaceName": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, format('rg-{0}', parameters('projectName'))), 'Microsoft.Resources/deployments', 'sentinel-deployment'), '2025-04-01').outputs.workspaceName.value]"
    },
    "workspaceId": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, format('rg-{0}', parameters('projectName'))), 'Microsoft.Resources/deployments', 'sentinel-deployment'), '2025-04-01').outputs.workspaceId.value]"
    }
  }
}